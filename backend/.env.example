# Database Configuration
MONGODB_URI=mongodb://admin:admin123@localhost:27017/locallink?authSource=admin
MONGODB_NAME=locallink

# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_change_this_in_production_12345
JWT_EXPIRE=7d

# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Admin Configuration
ADMIN_EMAIL=admin@locallink.com
ADMIN_PASSWORD=admin123

# Email Configuration (optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Recommendation Algorithm
LOCATION_WEIGHT=0.4
RATING_WEIGHT=0.3
TRUST_WEIGHT=0.3
SEARCH_RADIUS=5000
